BOT_TOKEN=123456:ABC...
# id админов через запятую (свой и заказчика). Узнать id: @userinfobot
ADMIN_IDS=1001875298
# куда приходят вопросы от людей; по умолчанию — личка первого админа. Можно id группы админов
# SUPPORT_CHAT_ID=
# канал необязателен. Если он есть: бот админ с правом приглашать и удалять людей
# CHANNEL_ID=-100xxxxxxxxxx
PROJECT_TITLE=Материалы МГУ

# Ручная оплата переводом по СБП (1 — включить)
MANUAL_PAY=0
MANUAL_PAY_PHONE=+79991234567
# банки через запятую: бот раздаёт их людям по очереди
MANUAL_PAY_BANKS=Т-Банк,Сбер
MANUAL_PAY_NAME=Иван И.
# куда приходят уведомления об оплатах; по умолчанию — туда же, куда вопросы
# MANUAL_PAY_CHAT_ID=
MANUAL_PAY_TTL_HOURS=24

# 1 — кнопка «Тестовая оплата» вместо реальной. Перед запуском поставить 0
TEST_PAYMENTS=1
# пробный доступ выключен. Чтобы включить на 1 день: TRIAL_DAYS=1
TRIAL_DAYS=0
TRIAL_SUBJECTS_LIMIT=1
REF_BONUS_DAYS=30
# каждый 5-й оплативший друг — подписка до конца курса
REF_BIG_EVERY=5
COURSE_END=30.06.2027
WINBACK_PERCENT=20
WINBACK_DAYS=3
RICH_FILES_PER_MESSAGE=40
PROTECT_CONTENT=1
